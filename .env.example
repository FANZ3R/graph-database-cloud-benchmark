# Copy to .env and fill in.  .env is gitignored - NEVER commit real values.

# ---- CognoDB Cloud (managed) ----
COGNODB_URI=
COGNODB_USER=cognodb
COGNODB_PASSWORD=
COGNODB_REGION=us-east4

# ---- Neo4j AuraDB Free (managed) ----
NEO4J_AURA_URI=
NEO4J_AURA_USER=04fc136a
NEO4J_AURA_PASSWORD=
NEO4J_AURA_REGION=unknown-not-selectable-on-free-tier

# ---- Memgraph (local Docker, capped) ----
MEMGRAPH_URI=bolt://localhost:7690
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ---- FalkorDB (local Docker, capped) ----
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# ---- ArangoDB (local Docker, capped) ----
ARANGO_URL=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=bench
ARANGO_DB=pokec

# ---- Benchmark knobs ----
# Sized to clear the assignment floor (>=100k rels) while staying under the
# most conservative published Aura Free cap (50k nodes / 175k rels).
# MAX_NODES is a hard ceiling -- the BFS sample is rejected if it exceeds it.
TARGET_RELATIONSHIPS=150000
MAX_NODES=45000
SAMPLE_SEED=20260820
READ_ITERATIONS=120
WARMUP_ITERATIONS=30
CONCURRENCY_LEVELS=1,10,40
